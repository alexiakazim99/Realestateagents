# Template only — no real values here. Copy to .env and fill in locally;
# .env is gitignored and must never be committed.
#
# Note: n8n itself doesn't read this file directly — credentials (OpenAI,
# header auth, etc.) live inside n8n's own encrypted credential store. This
# file documents what those values are and where they're needed, for anyone
# setting up or rotating the environment from scratch.

# --- n8n instance ---
N8N_API_URL=                 # e.g. http://localhost:5678
N8N_API_KEY=                 # n8n REST API key (n8n Settings > n8n API > create key)
N8N_PUBLIC_WEBHOOK_URL=      # Public URL the n8n webhooks are reachable at (e.g. an ngrok/Cloudflare Tunnel URL, or a real domain). Required for Tally to reach Lead Agent.

# --- Webhook security (Lead Agent) ---
WEBHOOK_SECURITY_MODE=header_api_key   # Auth mode used by the Lead Agent webhook trigger node ("headerAuth" in n8n)
LEAD_AGENT_API_KEY=          # Value sent in the x-api-key header by Tally; must match n8n credential "Header Auth account"

# --- OpenAI (used by all three agents via the "OpenAI account" n8n credential) ---
OPENAI_API_KEY=

# --- Tally (Lead Agent's lead source) ---
TALLY_FORM_ID=                # e.g. kdjp16 for "Intresseanmälan"
TALLY_WEBHOOK_TARGET_URL=     # ${N8N_PUBLIC_WEBHOOK_URL}/webhook/lead-agent — set this as the webhook URL in Tally's form integration settings
